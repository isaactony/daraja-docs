# Copy to .env and fill in. Never commit .env.
# Sandbox app keys from https://developer.safaricom.co.ke/dashboard/myapps
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
# Lipa na M-Pesa Online test shortcode and passkey (from the portal's test credentials)
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
# Your own Safaricom number, 2547XXXXXXXX. The sandbox sends a real prompt and moves real money
# (reversed by Safaricom at 6 AM the next day). Use Ksh 1.
DARAJA_TEST_PHONE=
# A public HTTPS URL that receives the callback. Must not contain "mpesa", "safaricom", "query", and so on.
DARAJA_CALLBACK_URL=
